    given-names: Shramee
repository-code: "https://github.com/mistcash/polyring"
url: "https://github.com/mistcash/polyring"
license: Apache-2.0
keywords:
  - zk-SNARK
  - recursion
  - groth16
  - pairing
  - gnark
  - polynomial ring
references:
